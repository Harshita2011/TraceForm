# Consistent text checkouts on Windows and Linux.
* text=auto
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.svg text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.docx binary
*.pptx binary

# Markdown uses trailing spaces for intentional hard line breaks.
*.md whitespace=-blank-at-eol
