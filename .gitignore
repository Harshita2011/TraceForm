# ─────────────────────────────────────────────────────────────────────────────
# Root .gitignore for TraceForm
# ─────────────────────────────────────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Databases & Runtime Data
*.db
*.sqlite
*.sqlite3
traceform.db
traceform.db-journal
traceform.db-wal
storage_data/*
!storage_data/.gitkeep
traceform/storage_data/*
!traceform/storage_data/.gitkeep

# Environment variables & secrets
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example
!.env.deploy.example
frontend/.env.local
frontend/.env.*.local

# Node & Next.js
node_modules/
frontend/node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnp
.pnp.*

# Next.js Build Output
.next/
frontend/.next/
out/
frontend/out/
.vercel

# TypeScript
*.tsbuildinfo
frontend/next-env.d.ts

# OS & Editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.vscode/
.idea/
*.log

# Local verification dependencies and browser captures
traceform/.runtime-deps/
frontend/.visual-check/

.runtime/

# Private keys, recovery material and generated reports
*.key
*.pem
*.p12
*.pfx
*.tfbackup
*.db-shm
*.db-wal
*.db-journal
traceform/eval/reports/

# Framework-generated local agent hints are documented under docs/development/.
frontend/AGENTS.md
frontend/CLAUDE.md
