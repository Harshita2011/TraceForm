# Copy to an ignored environment file, generate secrets, then use --env-file.
POSTGRES_PASSWORD=replace-with-random-hex
API_KEYS=replace-with-random-operator-key:administrator:admin
# Set to the exact HTTPS origin of the deployed frontend.
TRACEFORM_WEB_ORIGINS=https://traceform.example.com
TRACEFORM_MASTER_KEY=replace-with-a-Fernet-key
API_PORT=8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
