# §5 — TraceForm Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to source control.

# Database
DATABASE_URL=sqlite+aiosqlite:///./traceform.db

# Redis (Celery broker + result backend — used from Phase 2 onwards)
REDIS_URL=redis://localhost:6379/0

# Google Gemini LLM
GEMINI_API_KEY=
# Model string pinned per generation
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional comma-separated alternatives; use models available to your API key
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# Optional legacy fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5

# LLM Budget Controls (§4)
LLM_CALL_BUDGET_TOKENS=100000
LLM_CALL_BUDGET_CALLS=50

# Object Storage (local disk for now; swap OBJECT_STORAGE_PATH for S3 config later)
OBJECT_STORAGE_PATH=./storage_data

# API Authentication — comma-separated API keys for operators
API_KEYS=replace-with-your-api-key-1,replace-with-your-api-key-2

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Production: set a stable Fernet key; development creates a protected local key file.
# Generate a new key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRACEFORM_MASTER_KEY=
# Development auto-migrates. Production requires explicit python -m db.migrate by default.
# TRACEFORM_AUTO_MIGRATE=false
TRACEFORM_JOB_TIMEOUT_SECONDS=1800
# Exact frontend origins permitted for authenticated browser writes and CORS.
TRACEFORM_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
